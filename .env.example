# Ejemplo sin secretos. Node carga este archivo solo si usas --env-file=.env.
# Para desarrollo local no es necesario configurar estas variables.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATA_DIR=/app/data
# Origen exacto, sin ruta. Reemplazar por la URL HTTPS real.
PUBLIC_ORIGIN=https://tu-sitio.example
# Valores privados: configurarlos en el alojamiento, nunca en GitHub.
ADMIN_EMAIL=
ADMIN_PASSWORD=
